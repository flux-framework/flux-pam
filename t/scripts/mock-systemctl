#!/bin/sh
# Mock systemctl for testing flux-pam prolog/housekeeping
# Logs actions to systemctl.log in current directory instead of modifying
# systemd. Includes FLUX_JOB_ID in log line for per-job tracking.

JOBID=$(flux job id --to=f58 $FLUX_JOB_ID </dev/null)
LOGFILE="${SHARNESS_TRASH_DIRECTORY}/systemctl-${JOBID}.log"

# If MOCK_SYSTEMCTL_FAIL is set, exit 1 when args match its value
if test -n "${MOCK_SYSTEMCTL_FAIL}" \
    && echo "$*" | grep -q "${MOCK_SYSTEMCTL_FAIL}"; then
    echo "mock-systemctl exiting with error due to MOCK_SYSTEMCTL_FAIL" >&2
    exit 1
fi

# Reject DeviceAllow values real systemd rejects: each assignment is one
# "<path> <perms>" entry, so an embedded comma or a leading space fails.
for arg in "$@"; do
    case "$arg" in
    DeviceAllow=*,*)
        echo "mock-systemctl: $arg: requires combination of rwm flags" >&2
        exit 1
        ;;
    "DeviceAllow= "*)
        echo "mock-systemctl: $arg: requires device node or pattern" >&2
        exit 1
        ;;
    esac
done

# Log command with timestamp and job ID
# Format: timestamp jobid command args...
echo "$(date +%s.%N) $JOBID $*" >> "$LOGFILE"

exit 0
